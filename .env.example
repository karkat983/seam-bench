# Copy to .env (gitignored) and fill in what you use. Nothing here is needed for offline tests.

# Local models via Ollama (default provider in config.yaml). Change only if Ollama is remote.
OLLAMA_HOST=http://localhost:11434

# Only needed if config.yaml sets llm.provider: anthropic. Use your own key; never commit it.
ANTHROPIC_API_KEY=
